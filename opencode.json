{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "./.venv/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "tokensave": {
      "type": "local",
      "command": [
        "tokensave",
        "serve"
      ],
      "enabled": true
    },
    "mycelium-mind": {
      "type": "local",
      "command": [
        "node",
        "./mcp/build/mcp/src/index.js"
      ],
      "enabled": true
    }
  }
}